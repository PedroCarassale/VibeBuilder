# VibeBuilder backend - variables de entorno
# Copiar a `.env` antes de `npm start`.
# El backend carga `backend/.env` automáticamente al iniciar.
# En Vercel, configurar estas mismas claves en Project Settings → Environment Variables.

# Puerto HTTP del servidor (opcional, default 3000). No aplica en Vercel serverless.
PORT=3000

# Ruta del archivo SQLite local (opcional). En Vercel sin Turso se usa /tmp (no persistente).
DB_PATH=

# === Turso (recomendado en Vercel) — integración Storage en vercel.com ===
# Tras enlazar Turso: `cd backend && vercel env pull .env.development.local`
# En producción Vercel inyecta estas variables automáticamente.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# === Proveedor de generación (Vercel v0) ===

# API key de v0 (https://v0.app/chat/settings/keys).
# Si está vacía o no se define, el backend cae automáticamente al proveedor mock
# (`mock-v0`) y registra un warning. Esto evita romper el servidor en local.
V0_API_KEY=

# Secreto del servidor (>= 16 caracteres) para cifrar API keys de v0 guardadas por
# sesión vía PUT /integrations/v0 (modelo “cada dispositivo/sesión trae su key”).
# Sin esto, esas rutas responden 503 y solo aplica V0_API_KEY de entorno.
V0_KEYSTORE_SECRET=

# URL base opcional del API de v0 (default: https://api.v0.dev/v1).
# Útil para entornos de staging o tests contra mocks HTTP.
V0_API_URL=

# V0_TIMEOUT_MS / GENERATION_TIMEOUT_MS: reservadas por compatibilidad en generation-provider.js;
# el POST /projects/:id/prompts ya no aborta la llamada a v0 por tiempo (espera hasta respuesta o error).
